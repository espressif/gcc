/* Use "DEF_RVM_BASE_TYPE" macro to define RVM base types.
   The 'NAME' will be concatenated into intrinsic function name.  */
#ifndef DEF_RVM_BASE_TYPE
#define DEF_RVM_BASE_TYPE(NAME, TYPE)
#endif

DEF_RVM_BASE_TYPE (matrix, builtin_types[type_index].matrix)
DEF_RVM_BASE_TYPE (scalar, builtin_types[type_index].scalar)
DEF_RVM_BASE_TYPE (scalar_ptr, builtin_types[type_index].scalar_ptr)
DEF_RVM_BASE_TYPE (scalar_const_ptr, builtin_types[type_index].scalar_const_ptr)
DEF_RVM_BASE_TYPE (void, void_type_node)
DEF_RVM_BASE_TYPE (size, size_type_node)
DEF_RVM_BASE_TYPE (unsigned_matrix, builtin_types[type_index + 1].matrix)
DEF_RVM_BASE_TYPE (unsigned_scalar, builtin_types[type_index + 1].scalar)

DEF_RVM_BASE_TYPE (double_trunc_matrix, builtin_types[type_index - 11].matrix)

DEF_RVM_BASE_TYPE (matrix_mi8, 		builtin_types[RVM_TYPE_mint8_t].matrix)
