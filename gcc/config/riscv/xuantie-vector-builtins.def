/* Use "DEF_RVV_USI_OPS" macro include all signed integer which will be
   iterated and registered as intrinsic functions.  */
#ifndef DEF_RVV_USI_OPS
#define DEF_RVV_USI_OPS(TYPE, REQUIRE)
#endif

/* Use "DEF_RVV_SI_OPS" macro include all signed integer which will be
   iterated and registered as intrinsic functions.  */
#ifndef DEF_RVV_SI_OPS
#define DEF_RVV_SI_OPS(TYPE, REQUIRE)
#endif

/* Use "DEF_RVV_INT_TUPLE_OPS" macro include all tuple types
   which will be iterated and registered as intrinsic functions.  */
#ifndef DEF_RVV_INT_TUPLE_OPS
#define DEF_RVV_INT_TUPLE_OPS(TYPE, REQUIRE)
#endif

/* Use "DEF_RVV_LMUL1_I_S_OPS" macro include all integer types for LMUL1
   which will be iterated and registered as intrinsic functions. 64-bit types
   are not included for RV32 platforms.  */
#ifndef DEF_RVV_LMUL1_I_S_OPS
#define DEF_RVV_LMUL1_I_S_OPS(TYPE, REQUIRE)
#endif

/* Use "DEF_RVV_LMUL1_F_OPS" macro include all floating-point types for LMUL1
